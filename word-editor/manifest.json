{
  "id": "word-editor",
  "name": "Word Editor",
  "version": "0.2.0",
  "engine": ">=0.2.0",
  "description": "Word 文档编辑器：docx 导入、富文本编辑、AI 对话改稿、排版指令、版本快照，导出 docx/PDF",
  "author": "WorkAvatar",
  "main": "dist/main/index.cjs",
  "renderer": "dist/renderer/index.js",
  "locale": "locale",
  "ipc": [
    "doc-list", "doc-create", "doc-open", "doc-delete", "doc-rename", "doc-save",
    "doc-import-file", "export-save",
    "snapshot-list", "snapshot-create", "snapshot-restore", "snapshot-delete",
    "providers-list",
    "settings-get", "settings-set",
    "font-list",
    "doc-op-attach", "doc-op-result",
    "chat-send", "chat-cancel", "chat-history", "chats-list", "chat-delete", "chat-open-dir"
  ],
  "capabilities": [
    { "domain": "data", "entities": ["llmProviders"], "access": "read" },
    { "domain": "execute", "kinds": ["agent-chat"] }
  ],
  "vendor": [
    {
      "from": "node_modules/@forevka/wordcanvas/dist-lib",
      "to": "vendor/wordcanvas",
      "patch": "scripts/patch-wordcanvas.mjs"
    },
    {
      "from": "node_modules/@forevka/wordcanvas/dist-node/fonts",
      "to": "vendor/wordcanvas/assets/fonts"
    }
  ],
  "nav": {
    "label": "navLabel",
    "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 1.5h5.5L13 5v9.5H4z\"/><path d=\"M9.5 1.5V5H13\"/><path d=\"M5.7 8.1 6.8 12.3 8.2 10.2 9.6 12.3 10.7 8.1\"/></svg>",
    "order": 50,
    "detachable": true
  }
}
