{
  "name": "workavatar-plugin-workflow",
  "version": "1.2.0",
  "private": true,
  "description": "模板任务插件：画布搭建复杂任务流程（撰写/评审/条件/循环），编排数字员工与模板内联临时角色，驱动宿主流程编排引擎逐节点执行。",
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/build-plugin.mjs workflow",
    "build:zip": "node ../../scripts/build-plugin.mjs workflow --zip",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "adm-zip": "^0.6.1",
    "antd": "^6.6.6",
    "esbuild": "^0.28.0",
    "i18next": "^26.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "typescript": "^7.0.2"
  }
}
