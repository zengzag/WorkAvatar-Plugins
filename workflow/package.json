{
  "name": "workavatar-plugin-workflow",
  "version": "1.0.0",
  "private": true,
  "description": "模板任务插件：画布搭建复杂任务流程（撰写/评审/条件/循环），编排数字员工与模板内联临时角色，驱动宿主流程编排引擎逐节点执行。",
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/build-plugin.mjs workflow",
    "build:zip": "node ../../scripts/build-plugin.mjs workflow --zip",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.2.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "adm-zip": "^0.5.17",
    "antd": "^6.3.7",
    "esbuild": "^0.28.0",
    "i18next": "^26.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.7",
    "typescript": "^6.0.3"
  }
}
